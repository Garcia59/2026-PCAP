# Objetico: um programa que leia três valores com ponto flutuante de dupla precisão

# --- ANÁLISE (LIAC) ---
# Entrada: três valores com ponto flutuante
# Processamento: X, Y e Z Em seguida, calcule e mostre
# Saída: O arquivo de saída deverá conter 5 linhas de dados

# O valor calculado deve ser apresentado com 3 dígitos após o ponto decimal
parts = []
while len(parts) < 3:
    parts.extend(input().split())
X, Y, Z = map(float, parts[:3])

# conter 5 linhas de dados e deve ser apresentado com 3 dígitos após o ponto decimal
print(f"TRIANGULO: {(X * Z) / 2:.3f}")
print(f"CIRCULO: {3.14159 * Z ** 2:.3f}")
print(f"TRAPEZIO: {((X + Y) * Z) / 2:.3f}")
print(f"QUADRADO: {Y ** 2:.3f}")
print(f"RETANGULO: {X * Y:.3f}")