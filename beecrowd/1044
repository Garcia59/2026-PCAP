# Objetivo: verificar se dois inteiros são múltiplos entre si 

# --- ANÁLISE (LIAC) ---
# Entrada: dois inteiros A e B na mesma linha separados por espaço
# Processamento: identificar maior e menor, veriicar se maior % menor -- 0 
# Saída: "Sao Multiplos" ou "Nao sao Multiplos"

A, B = input().split()
A = int(A)
B = int(B)

# Identificar maior e menor para aplicar o operador % corretamente
# (o resto sempre deve ser calculado dividindo o maior pelo menor)
if A > B:
    maior = A
    menor = B
else:
    maior = B
    menor = A

# Operador % (módulo): retorna o resto da divisão inteira
# Se o resto for 0, o maior é múltiplo do menor são múltiplos emtre si
if maior % menor == 0:
    print("Sao Multiplos")
else:
    print("Nao sao Multiplos")